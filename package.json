{
  "name": "word-atlas",
  "version": "1.0.0",
  "type": "module",
  "description": "A beautiful, open IELTS vocabulary atlas: 7,000+ illustrated words with UK/US audio, original examples and FSRS spaced repetition.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check:atlas": "node scripts/check-atlas.mjs",
    "build:atlas": "python3 scripts/atlas/build_atlas.py",
    "render:cards": "node scripts/render-cards.mjs",
    "pack:public": "python3 scripts/package_public.py --out ../开源发布/word-atlas",
    "format": "prettier --write src vite.config.ts scripts/*.mjs package.json tsconfig.json",
    "build:cloudflare": "npm run build && node scripts/cloudflare/prepare.mjs",
    "deploy:cloudflare": "node scripts/cloudflare/deploy.mjs",
    "check:cloudflare": "wrangler types cloudflare/worker-configuration.d.ts --include-runtime false && tsc -p cloudflare/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "wrangler": "4.153.0"
  },
  "private": true,
  "license": "MIT"
}
